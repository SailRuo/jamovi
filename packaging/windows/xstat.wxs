<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v6:  wix build -d PayloadDir=... -d ProductVersion=... -o X-Stat.msi xstat.wxs
  UpgradeCode is stable for X-Stat — do not change between releases.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="X-Stat"
      Manufacturer="X-Stat"
      Version="$(var.ProductVersion)"
      UpgradeCode="B7E2C9A1-4F3D-4E8B-9C21-A1D5E6F70829"
      Scope="perMachine"
      Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of X-Stat is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="X-Stat">
        <Directory Id="BinFolder" Name="bin" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="X-Stat" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="X-Stat" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="C1A2B3D4-E5F6-7890-ABCD-EF1234567890">
      <Shortcut
          Id="StartMenuXStat"
          Name="X-Stat"
          Target="[INSTALLFOLDER]bin\X-Stat.exe"
          WorkingDirectory="BinFolder" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\X-Stat" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="D2B3C4E5-F6A7-8901-BCDE-F12345678901">
      <Shortcut
          Id="DesktopXStat"
          Name="X-Stat"
          Target="[INSTALLFOLDER]bin\X-Stat.exe"
          WorkingDirectory="BinFolder" />
      <RegistryValue Root="HKCU" Key="Software\X-Stat" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
